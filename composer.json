{
    "name": "xaniashield/laravel",
    "description": "Privacy-first, EU-hosted spam protection for Laravel forms. Official Laravel client for the Xania Shield API.",
    "keywords": ["laravel", "spam", "anti-spam", "spam-protection", "gdpr", "privacy", "honeypot", "bot-detection", "xania-shield"],
    "homepage": "https://xaniashield.com",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "XaniaCode",
            "homepage": "https://xaniacode.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "XaniaShield\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XaniaShield\\Laravel\\ShieldServiceProvider"
            ],
            "aliases": {
                "Shield": "XaniaShield\\Laravel\\Facades\\Shield"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
